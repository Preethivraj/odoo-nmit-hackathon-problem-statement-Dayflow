<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Employee Profile Management</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        body {
            background: #f4f7fb;
            color: #1f2937;
        }

        .sidebar {
            position: fixed;
            width: 240px;
            height: 100vh;
            background: linear-gradient(180deg, #172554, #2563eb);
            color: white;
            padding: 25px 15px;
            animation: slideLeft 0.7s ease;
        }

        .logo {
            text-align: center;
            font-size: 24px;
            font-weight: bold;
            margin-bottom: 40px;
        }

        .menu {
            list-style: none;
        }

        .menu li {
            padding: 15px;
            margin: 8px 0;
            border-radius: 10px;
            cursor: pointer;
            transition: 0.3s;
        }

        .menu li:hover,
        .menu .active {
            background: rgba(255,255,255,0.2);
            transform: translateX(5px);
        }


        .main {
            margin-left: 240px;
            padding: 30px;
        }

        .topbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
            animation: fadeDown 0.8s ease;
        }

        .topbar h1 {
            font-size: 28px;
        }

        .user {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .user img {
            width: 45px;
            height: 45px;
            border-radius: 50%;
            border: 3px solid #2563eb;
        }


        .profile-card {
            background: white;
            border-radius: 18px;
            padding: 25px;
            display: flex;
            align-items: center;
            gap: 25px;
            box-shadow: 0 8px 25px rgba(0,0,0,0.08);
            margin-bottom: 25px;
            animation: fadeUp 0.8s ease;
            transition: 0.3s;
        }

        .profile-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 35px rgba(0,0,0,0.12);
        }

        .profile-image {
            width: 110px;
            height: 110px;
            border-radius: 50%;
            border: 5px solid #dbeafe;
            object-fit: cover;
        }

        .profile-info h2 {
            font-size: 25px;
            margin-bottom: 7px;
        }

        .profile-info p {
            color: #6b7280;
            margin: 5px 0;
        }

        .status {
            display: inline-block;
            background: #dcfce7;
            color: #15803d;
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 13px;
            margin-top: 8px;
        }


        .dashboard-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            margin-bottom: 25px;
        }

        .stat-card {
            background: white;
            padding: 22px;
            border-radius: 15px;
            box-shadow: 0 6px 20px rgba(0,0,0,0.06);
            transition: 0.3s;
            animation: scaleIn 0.7s ease;
        }

        .stat-card:hover {
            transform: translateY(-7px);
        }

        .stat-card h3 {
            color: #6b7280;
            font-size: 14px;
            margin-bottom: 10px;
        }

        .stat-card h2 {
            font-size: 25px;
            color: #2563eb;
        }


        .content-grid {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 20px;
        }

        .card {
            background: white;
            padding: 25px;
            border-radius: 18px;
            box-shadow: 0 6px 20px rgba(0,0,0,0.06);
            animation: fadeUp 1s ease;
        }

        .card h2 {
            margin-bottom: 20px;
            font-size: 20px;
            color: #172554;
        }


        .details {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 18px;
        }

        .detail-box {
            background: #f8fafc;
            padding: 15px;
            border-radius: 10px;
            transition: 0.3s;
        }

        .detail-box:hover {
            background: #eff6ff;
            transform: translateX(5px);
        }

        .detail-box span {
            display: block;
            font-size: 12px;
            color: #6b7280;
            margin-bottom: 6px;
        }

        .detail-box strong {
            font-size: 15px;
        }


        .document {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 15px;
            border-bottom: 1px solid #e5e7eb;
            transition: 0.3s;
        }

        .document:hover {
            background: #f8fafc;
            padding-left: 20px;
        }

        .document:last-child {
            border-bottom: none;
        }

        .doc-name {
            font-weight: bold;
        }

        .doc-type {
            color: #6b7280;
            font-size: 12px;
            margin-top: 4px;
        }

        .view-btn {
            background: #2563eb;
            color: white;
            border: none;
            padding: 7px 12px;
            border-radius: 7px;
            cursor: pointer;
            transition: 0.3s;
        }

        .view-btn:hover {
            background: #1d4ed8;
            transform: scale(1.05);
        }

//adding salary details

.salary-item {
            display: flex;
            justify-content: space-between;
            padding: 12px 0;
            border-bottom: 1px solid #eee;
        }

        .salary-item:last-child {
            border-bottom: none;
        }

        .total {
            font-weight: bold;
            color: #2563eb;
            font-size: 18px;
        }


        @keyframes slideLeft {
            from {
                transform: translateX(-100%);
            }
            to {
                transform: translateX(0);
            }
        }

        @keyframes fadeDown {
            from {
                opacity: 0;
                transform: translateY(-20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @keyframes scaleIn {
            from {
                opacity: 0;
                transform: scale(0.9);
            }
            to {
                opacity: 1;
                transform: scale(1);
            }
        }


        @media (max-width: 1000px) {

            .sidebar {
                width: 200px;
            }

            .main {
                margin-left: 200px;
            }

            .dashboard-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .content-grid {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 700px) {

            .sidebar {
                position: relative;
                width: 100%;
                height: auto;
            }

            .main {
                margin-left: 0;
                padding: 15px;
            }

            .dashboard-grid {
                grid-template-columns: 1fr;
            }

            .details {
                grid-template-columns: 1fr;
            }

            .profile-card {
                flex-direction: column;
                text-align: center;
            }

            .topbar {
                flex-direction: column;
                align-items: flex-start;
                gap: 15px;
            }
        }
    </style>
