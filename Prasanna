                    </div>

                    <button class="view-btn">
                        View
                    </button>

                </div>


                <div class="document">

                    <div class="document-info">

                        <div class="document-icon">
                            🎓
                        </div>

                        <div>

                            <strong>
                                Educational Certificate
                            </strong>

                            <p>
                                PDF • 2.1 MB
                            </p>

                        </div>

                    </div>

                    <button class="view-btn">
                        View
