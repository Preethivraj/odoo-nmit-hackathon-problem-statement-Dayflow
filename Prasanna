        </section>


        <!-- ================= EDIT PROFILE ================= -->

        <section
            class="edit-section"
            id="editSection"
        >

            <h2>
                ✏️ Edit Profile
            </h2>

            <p style="color:#64748b;margin-bottom:20px;">
                Employees can edit only their phone number,
                address and profile picture.
            </p>


            <div class="form-grid">


                <!-- PHONE -->

                <div class="form-group">

                    <label>
                        Phone Number
                    </label>

                    <input
                        type="tel"
                        id="phone"
                        value="+91 98765 43210"
                    >

                </div>


                <!-- EMAIL READ ONLY -->

                <div class="form-group">

                    <label>
                        Email
                    </label>

                    <input
                        type="email"
                        value="rohith@example.com"
                        disabled
                    >

                </div>


                <!-- ADDRESS -->

                <div class="form-group full">

                    <label>
                        Address
                    </label>

                    <input
                        type="text"
                        id="address"
                        value="Chennai, Tamil Nadu"
                    >

                </div>


                <!-- PROFILE PICTURE -->

                <div class="form-group full">

                    <label>
                        Profile Picture
                    </label>

                    <input
                        type="file"
                        id="imageUpload"
                        accept="image/*"
                        onchange="previewImage(event)"
                    >

                </div>

            </div>


            <button
                class="save-btn"
                onclick="saveProfile()"
            >
                💾 Save Changes
            </button>

        </section>


        <!-- ================= ADMIN PANEL ================= -->

        <section class="admin-panel">

            <h2>
                🔐 Admin / HR Access
            </h2>

            <p>
                Administrators can edit all employee details,
                including personal information, job details,
                salary structure and documents.
            </p>

            <button
                class="admin-btn"
                onclick="adminMode()"
            >
                Open Admin Edit Mode
            </button>

        </section>


    </main>


    <!-- ================= JAVASCRIPT ================= -->

    <script>

        /* ================= SCROLL TO EDIT ================= */

        function scrollToEdit() {

            document.getElementById("editSection")
                .scrollIntoView({
                    behavior: "smooth"
                });

        }


        /* ================= IMAGE PREVIEW ================= */

        function previewImage(event) {

            const file = event.target.files[0];

            if (file) {

                const reader = new FileReader();

                reader.onload = function(e) {

                    document.getElementById("profileImage").src =
                        e.target.result;

                };

                reader.readAsDataURL(file);

            }

        }


        /* ================= SAVE PROFILE ================= */

        function saveProfile() {

            const phone =
                document.getElementById("phone").value;

            const address =
                document.getElementById("address").value;

            if (phone === "" || address === "") {

                alert("Please fill all editable fields.");

                return;

            }

            alert(
                "Profile updated successfully! ✅"
            );

        }


        /* ================= ADMIN MODE ================= */

        function adminMode() {

            alert(
                "Admin Edit Mode activated.\n\n" +
                "Admin can edit:\n" +
                "• Personal Details\n" +
                "• Job Details\n" +
                "• Salary Structure\n" +
                "• Documents\n" +
                "• Profile Picture"
            );

        }

    </script>

</body>
</html>
