<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Employee Profile Management</title>

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: "Segoe UI", Arial, sans-serif;
        }

        body {
            background: #f1f5f9;
            color: #1e293b;
        }

        /* ================= SIDEBAR ================= */

        .sidebar {
            position: fixed;
            left: 0;
            top: 0;
            width: 240px;
            height: 100vh;
            background: linear-gradient(180deg, #172554, #1e40af);
            color: white;
            padding: 25px 15px;
            animation: slideLeft 0.7s ease;
        }

        .logo {
            text-align: center;
            font-size: 23px;
            font-weight: bold;
            margin-bottom: 40px;
        }

        .logo span {
            color: #60a5fa;
        }

        .menu a {
            display: block;
            color: #dbeafe;
            text-decoration: none;
            padding: 14px 18px;
            margin: 8px 0;
            border-radius: 10px;
            transition: 0.3s;
        }

        .menu a:hover,
        .menu a.active {
            background: rgba(255,255,255,0.18);
            transform: translateX(6px);
        }

        /* ================= MAIN ================= */

        .main {
            margin-left: 240px;
            padding: 25px;
        }

        /* ================= HEADER ================= */

        .header {
            background: white;
            padding: 18px 25px;
            border-radius: 15px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 5px 20px rgba(0,0,0,0.06);
            animation: fadeDown 0.7s ease;
        }

        .header h1 {
            font-size: 25px;
        }

        .header p {
            color: #64748b;
            margin-top: 4px;
        }

        .user {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .avatar-small {
            width: 45px;
            height: 45px;
            border-radius: 50%;
            background: linear-gradient(135deg,#2563eb,#60a5fa);
            color: white;
            display: flex;
            justify-content: center;
            align-items: center;
            font-weight: bold;
        }

        /* ================= PROFILE HEADER ================= */

        .profile-header {
            margin-top: 25px;
            background: linear-gradient(135deg,#2563eb,#4f46e5);
            padding: 30px;
            border-radius: 18px;
            color: white;
            display: flex;
            align-items: center;
            gap: 25px;
            animation: fadeUp 0.8s ease;
        }

        .profile-picture {
            position: relative;
        }

        .profile-picture img {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            object-fit: cover;
            border: 4px solid white;
            background: white;
            transition: 0.3s;
        }

        .profile-picture img:hover {
            transform: scale(1.06);
        }

        .profile-info h2 {
            font-size: 28px;
            margin-bottom: 6px;
        }

        .profile-info p {
            margin: 4px 0;
            opacity: 0.9;
        }

        .employee-badge {
            display: inline-block;
            margin-top: 10px;
            padding: 6px 14px;
            border-radius: 20px;
            background: rgba(255,255,255,0.2);
        }

        /* ================= BUTTON ================= */

        .edit-btn {
            margin-left: auto;
            padding: 12px 20px;
            border: none;
            border-radius: 9px;
            background: white;
            color: #2563eb;
            font-weight: bold;
            cursor: pointer;
            transition: 0.3s;
        }

        .edit-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(0,0,0,0.15);
        }

        /* ================= GRID ================= */

        .profile-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-top: 25px;
        }

        .card {
            background: white;
            padding: 25px;
            border-radius: 16px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.06);
            animation: scaleIn 0.8s ease;
            transition: 0.3s;
        }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 30px rgba(0,0,0,0.09);
        }

        .card h2 {
            margin-bottom: 20px;
            font-size: 20px;
            color: #1e3a8a;
        }

        /* ================= DETAILS ================= */

        .detail {
            display: flex;
            justify-content: space-between;
            padding: 13px 0;
            border-bottom: 1px solid #e2e8f0;
        }

        .detail:last-child {
            border-bottom: none;
        }

        .label {
            color: #64748b;
        }

        .value {
            font-weight: 600;
            text-align: right;
        }

        /* ================= SALARY ================= */

        .salary-row {
            display: flex;
            justify-content: space-between;
            padding: 13px 0;
            border-bottom: 1px solid #e2e8f0;
        }

        .salary-total {
            margin-top: 15px;
            padding: 15px;
            background: #eff6ff;
            border-radius: 10px;
            display: flex;
            justify-content: space-between;
            font-weight: bold;
            color: #1d4ed8;
        }

        /* ================= DOCUMENTS ================= */

        .document {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 15px;
            margin-bottom: 12px;
            background: #f8fafc;
            border-radius: 10px;
            transition: 0.3s;
        }

        .document:hover {
            background: #eff6ff;
            transform: translateX(5px);
        }

        .document-info {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .document-icon {
            width: 42px;
            height: 42px;
            background: #dbeafe;
            border-radius: 9px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
        }

        .view-btn {
            border: none;
            padding: 7px 12px;
            border-radius: 7px;
            background: #2563eb;
            color: white;
            cursor: pointer;
        }

        /* ================= EDIT PROFILE ================= */

        .edit-section {
            margin-top: 25px;
            background: white;
            padding: 25px;
            border-radius: 16px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.06);
            animation: fadeUp 1s ease;
        }

        .edit-section h2 {
            color: #1e3a8a;
            margin-bottom: 20px;
        }

        .form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 18px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
        }

        .form-group label {
            margin-bottom: 7px;
            font-weight: 600;
            color: #475569;
        }

        .form-group input {
            padding: 12px;
            border: 1px solid #cbd5e1;
            border-radius: 8px;
            outline: none;
            transition: 0.3s;
        }

        .form-group input:focus {
            border-color: #2563eb;
            box-shadow: 0 0 0 3px rgba(37,99,235,0.1);
        }

        .full {
            grid-column: span 2;
        }

        .save-btn {
            margin-top: 20px;
            padding: 12px 25px;
            background: #2563eb;
            color: white;
            border: none;
            border-radius: 9px;
            font-weight: bold;
            cursor: pointer;
            transition: 0.3s;
        }

        .save-btn:hover {
            background: #1d4ed8;
            transform: translateY(-3px);
        }

        /* ================= ADMIN PANEL ================= */

        .admin-panel {
            margin-top: 25px;
            background: #fff7ed;
            border: 1px solid #fed7aa;
            padding: 25px;
            border-radius: 16px;
            animation: fadeUp 1.1s ease;
        }

        .admin-panel h2 {
            color: #c2410c;
            margin-bottom: 10px;
        }

        .admin-panel p {
            color: #7c2d12;
            margin-bottom: 18px;
        }

        .admin-btn {
            background: #ea580c;
            color: white;
            border: none;
            padding: 11px 20px;
            border-radius: 8px;
            cursor: pointer;
            transition: 0.3s;
        }

        .admin-btn:hover {
            background: #c2410c;
            transform: scale(1.04);
        }

        /* ================= HIDDEN ================= */

        .hidden {
            display: none;
        }

        /* ================= ANIMATIONS ================= */

        @keyframes slideLeft {

            from {
                transform: translateX(-100%);
            }

            to {
                transform: translateX(0);
            }

        }

        @keyframes fadeDown {

            from {
                opacity: 0;
                transform: translateY(-20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }

        }

        @keyframes fadeUp {

            from {
                opacity: 0;
                transform: translateY(25px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }

        }

        @keyframes scaleIn {

            from {
                opacity: 0;
                transform: scale(0.93);
            }

            to {
                opacity: 1;
                transform: scale(1);
            }

        }

        /* ================= RESPONSIVE ================= */

        @media(max-width: 900px) {

            .profile-grid {
                grid-template-columns: 1fr;
            }

            .form-grid {
                grid-template-columns: 1fr;
            }

            .full {
                grid-column: span 1;
            }

        }

        @media(max-width: 700px) {

            .sidebar {
                position: relative;
                width: 100%;
                height: auto;
            }

            .main {
                margin-left: 0;
            }

            .profile-header {
                flex-direction: column;
                text-align: center;
            }

            .edit-btn {
                margin-left: 0;
            }

            .header {
                flex-direction: column;
                gap: 15px;
            }

        }

    </style>
</head>


<body>

    <!-- ================= SIDEBAR ================= -->

    <aside class="sidebar">

        <div class="logo">
            <span>EMP</span> Portal
        </div>

        <nav class="menu">

            <a href="#">🏠 Dashboard</a>

            <a href="#" class="active">
                👤 Profile
            </a>

            <a href="#">
                📅 Attendance
            </a>

            <a href="#">
                📝 Leave Requests
            </a>

            <a href="#">
                🔔 Notifications
            </a>

            <a href="#">
                ⚙️ Settings
            </a>

            <a href="#">
                🚪 Logout
            </a>

        </nav>

    </aside>


    <!-- ================= MAIN ================= -->

    <main class="main">


        <!-- HEADER -->

        <header class="header">

            <div>

                <h1>Employee Profile</h1>

                <p>
                    View and manage your employee information
                </p>

            </div>


            <div class="user">

                <div>

                    <strong>Rohith B</strong>

                    <small>
