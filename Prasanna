<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Employee Profile Management</title>

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: "Segoe UI", Arial, sans-serif;
        }

        body {
            background: #f1f5f9;
            color: #1e293b;
        }

        /* ================= SIDEBAR ================= */

        .sidebar {
            position: fixed;
            left: 0;
            top: 0;
            width: 240px;
            height: 100vh;
            background: linear-gradient(180deg, #172554, #1e40af);
            color: white;
            padding: 25px 15px;
            animation: slideLeft 0.7s ease;
        }

        .logo {
            text-align: center;
            font-size: 23px;
            font-weight: bold;
            margin-bottom: 40px;
        }

        .logo span {
            color: #60a5fa;
        }

        .menu a {
            display: block;
            color: #dbeafe;
            text-decoration: none;
            padding: 14px 18px;
            margin: 8px 0;
            border-radius: 10px;
            transition: 0.3s;
        }

        .menu a:hover,
        .menu a.active {
            background: rgba(255,255,255,0.18);
            transform: translateX(6px);
        }

        /* ================= MAIN ================= */

        .main {
            margin-left: 240px;
            padding: 25px;
        }

        /* ================= HEADER ================= */

        .header {
            background: white;
            padding: 18px 25px;
            border-radius: 15px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 5px 20px rgba(0,0,0,0.06);
            animation: fadeDown 0.7s ease;
        }

        .header h1 {
            font-size: 25px;
        }

        .header p {
            color: #64748b;
            margin-top: 4px;
        }

        .user {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .avatar-small {
            width: 45px;
            height: 45px;
            border-radius: 50%;
            background: linear-gradient(135deg,#2563eb,#60a5fa);
            color: white;
            display: flex;
            justify-content: center;
            align-items: center;
            font-weight: bold;
        }

        /* ================= PROFILE HEADER ================= */

        .profile-header {
            margin-top: 25px;
            background: linear-gradient(135deg,#2563eb,#4f46e5);
            padding: 30px;
            border-radius: 18px;
            color: white;
            display: flex;
            align-items: center;
            gap: 25px;
            animation: fadeUp 0.8s ease;
        }

        .profile-picture {
            position: relative;
        }

        .profile-picture img {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            object-fit: cover;
            border: 4px solid white;
            background: white;
            transition: 0.3s;
        }

        .profile-picture img:hover {
            transform: scale(1.06);
        }

        .profile-info h2 {
            font-size: 28px;
            margin-bottom: 6px;
        }

        .profile-info p {
            margin: 4px 0;
            opacity: 0.9;
        }

        .employee-badge {
            display: inline-block;
            margin-top: 10px;
            padding: 6px 14px;
            border-radius: 20px;
            background: rgba(255,255,255,0.2);
        }
