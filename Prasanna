            </div>

        </header>


        <!-- ================= PROFILE HEADER ================= -->

        <section class="profile-header">

            <div class="profile-picture">

                <img
                    id="profileImage"
                    src="https://i.pravatar.cc/150?img=12"
                    alt="Profile Picture"
