                <p>
                    Computer Science & Engineering
                </p>

                <span class="employee-badge">
                    EMP001
                </span>

            </div>


            <button
                class="edit-btn"
                onclick="scrollToEdit()"
            >
                ✏️ Edit Profile
            </button>

        </section>


        <!-- ================= PROFILE DETAILS ================= -->

        <section class="profile-grid">


            <!-- PERSONAL DETAILS -->

            <div class="card">

                <h2>👤 Personal Details</h2>

                <div class="detail">

                    <span class="label">
                        Full Name
                    </span>

                    <span class="value">
                        Rohith B
                    </span>

                </div>


                <div class="detail">

                    <span class="label">
                        Date of Birth
                    </span>

                    <span class="value">
                        15 May 2003
                    </span>

                </div>


                <div class="detail">

                    <span class="label">
                        Gender
                    </span>

                    <span class="value">
                        Male
                    </span>

                </div>


                <div class="detail">

                    <span class="label">
                        Email
                    </span>

                    <span class="value">
                        rohith@example.com
                    </span>

                </div>


                <div class="detail">

                    <span class="label">
                        Phone
                    </span>

                    <span class="value">
                        +91 98765 43210
                    </span>

                </div>


                <div class="detail">

                    <span class="label">
                        Address
                    </span>

                    <span class="value">
                        Chennai, Tamil Nadu
                    </span>

                </div>

            </div>


            <!-- JOB DETAILS -->

            <div class="card">

                <h2>💼 Job Details</h2>

                <div class="detail">

                    <span class="label">
                        Employee ID
                    </span>

                    <span class="value">
                        EMP001
                    </span>

                </div>


                <div class="detail">

                    <span class="label">
                        Department
                    </span>

                    <span class="value">
                        IT
                    </span>

                </div>


                <div class="detail">

                    <span class="label">
                        Designation
                    </span>

                    <span class="value">
                        Software Developer
                    </span>

                </div>


                <div class="detail">

                    <span class="label">
                        Joining Date
                    </span>

                    <span class="value">
                        10 June 2024
                    </span>

                </div>


                <div class="detail">

                    <span class="label">
                        Employment Type
                    </span>

                    <span class="value">
                        Full Time
                    </span>

                </div>


                <div class="detail">

                    <span class="label">
                        Reporting Manager
                    </span>

                    <span class="value">
                        Arun Kumar
                    </span>

                </div>

            </div>


            <!-- SALARY STRUCTURE -->

            <div class="card">

                <h2>💰 Salary Structure</h2>

                <div class="salary-row">

                    <span>
                        Basic Salary
                    </span>

                    <strong>
                        ₹35,000
                    </strong>

                </div>


                <div class="salary-row">

                    <span>
                        HRA
                    </span>

                    <strong>
                        ₹12,000
                    </strong>

                </div>


                <div class="salary-row">

                    <span>
                        Transport Allowance
                    </span>

                    <strong>
                        ₹3,000
                    </strong>

                </div>


                <div class="salary-row">

                    <span>
                        Other Allowances
                    </span>

                    <strong>
                        ₹5,000
                    </strong>

                </div>


                <div class="salary-total">

                    <span>
                        Monthly Gross Salary
                    </span>

                    <span>
                        ₹55,000
                    </span>

                </div>

            </div>


            <!-- DOCUMENTS -->

            <div class="card">

                <h2>📄 Documents</h2>


                <div class="document">

                    <div class="document-info">

                        <div class="document-icon">
                            📄
                        </div>

                        <div>

                            <strong>
                                Aadhaar Card
                            </strong>

                            <p>
                                PDF • 1.2 MB
