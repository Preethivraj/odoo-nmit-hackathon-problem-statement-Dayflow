                    </div>

                </div>

            </div>


            <!-- Alerts -->

            <div class="panel">

                <h2>Alerts 🔔</h2>

                <div class="notification">
                    <strong>Attendance</strong>
                    <p>Please mark your attendance before 10 AM.</p>
                </div>

                <div class="notification">
                    <strong>HR Notice</strong>
                    <p>Monthly meeting scheduled for Monday.</p>
                </div>

            </div>

        </section>


        <!-- ================= ADMIN / HR ================= -->

        <section class="admin-section">

            <div class="admin-title">

                <div>
                    <h2>Admin / HR Dashboard</h2>
                    <p>Manage employees, attendance and leave requests.</p>
                </div>

                <button class="switch-btn">
                    Switch Employee
                </button>

            </div>


            <!-- Employee Management -->

            <div class="panel">

                <h2>Employee List 👥</h2>

                <table>

                    <thead>

                        <tr>
                            <th>Employee ID</th>
