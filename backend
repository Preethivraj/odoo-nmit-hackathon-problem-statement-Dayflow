// code for the dashboard page
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Employee Management Dashboard</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: "Segoe UI", sans-serif;
        }

        body {
            background: #f4f7fb;
            color: #1e293b;
        }

        /* ================= SIDEBAR ================= */

        .sidebar {
            position: fixed;
            left: 0;
            top: 0;
            width: 240px;
            height: 100vh;
            background: linear-gradient(180deg, #172554, #1e40af);
            color: white;
            padding: 25px 15px;
            animation: slideIn 0.7s ease;
        }

        .logo {
            text-align: center;
            font-size: 23px;
            font-weight: bold;
            margin-bottom: 40px;
        }

        .logo span {
            color: #60a5fa;
        }

        .menu a {
            display: block;
            padding: 14px 18px;
            margin: 8px 0;
            color: #dbeafe;
            text-decoration: none;
            border-radius: 10px;
            transition: 0.3s;
        }

        .menu a:hover,
        .menu a.active {
            background: rgba(255,255,255,0.18);
            transform: translateX(6px);
        }

        /* ================= MAIN ================= */

        .main {
            margin-left: 240px;
            padding: 25px;
        }

        /* ================= HEADER ================= */

        .header {
            background: white;
            padding: 18px 25px;
            border-radius: 15px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 5px 20px rgba(0,0,0,0.06);
            animation: fadeDown 0.7s ease;
        }

        .header h1 {
            font-size: 25px;
        }

        .user {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .avatar {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            background: linear-gradient(135deg, #2563eb, #60a5fa);
            color: white;
            display: flex;
            justify-content: center;
            align-items: center;
            font-weight: bold;
        }

        /* ================= WELCOME ================= */

        .welcome {
            margin-top: 25px;
            padding: 28px;
            border-radius: 18px;
            color: white;
            background: linear-gradient(135deg, #2563eb, #4f46e5);
            animation: fadeUp 0.8s ease;
        }

        .welcome h2 {
            margin-bottom: 8px;
        }

        /* ================= CARDS ================= */

        .cards {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            margin-top: 25px;
        }

        .card {
            background: white;
            padding: 25px;
            border-radius: 16px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.06);
            transition: 0.35s;
            animation: scaleIn 0.7s ease;
            cursor: pointer;
        }

        .card:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 30px rgba(37,99,235,0.15);
        }

        .card-icon {
            width: 50px;
            height: 50px;
            border-radius: 12px;
            background: #dbeafe;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 25px;
            margin-bottom: 15px;
        }

        .card h3 {
            margin-bottom: 8px;
        }

        .card p {
            color: #64748b;
            font-size: 14px;
        }

        /* ================= CONTENT ================= */

        .content {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 20px;
            margin-top: 25px;
        }

        .panel {
            background: white;
            padding: 25px;
            border-radius: 16px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.06);
            animation: fadeUp 1s ease;
        }

        .panel h2 {
            margin-bottom: 20px;
        }

        /* ================= ACTIVITY ================= */

        .activity {
            display: flex;
            gap: 15px;
            padding: 15px 0;
            border-bottom: 1px solid #e2e8f0;
        }

        .activity:last-child {
            border-bottom: none;
        }

        .activity-icon {
            width: 38px;
            height: 38px;
            background: #dcfce7;
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        /* ================= NOTIFICATIONS ================= */

        .notification {
            padding: 15px;
            margin-bottom: 12px;
            border-radius: 10px;
            background: #eff6ff;
            border-left: 4px solid #2563eb;
            transition: 0.3s;
        }

        .notification:hover {
            transform: translateX(5px);
        }

        /* ================= ADMIN SECTION ================= */

        .admin-section {
            margin-top: 30px;
            animation: fadeUp 1s ease;
        }

        .admin-title {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 18px;
        }

        .switch-btn {
            background: #2563eb;
            border: none;
            color: white;
            padding: 10px 18px;
            border-radius: 8px;
            cursor: pointer;
            transition: 0.3s;
        }

        .switch-btn:hover {
            background: #1d4ed8;
            transform: scale(1.05);
        }

        /* ================= TABLE ================= */

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th,
        td {
            padding: 14px;
            text-align: left;
            border-bottom: 1px solid #e2e8f0;
        }

        th {
            color: #475569;
            background: #f8fafc;
        }

        tr {
            transition: 0.3s;
        }

        tr:hover {
            background: #f8fafc;
            transform: scale(1.005);
        }

        .status {
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 12px;
        }

        .active-status {
            background: #dcfce7;
            color: #15803d;
        }

        .leave-status {
            background: #fef3c7;
            color: #b45309;
        }

        /* ================= BUTTONS ================= */

        .approve {
            background: #16a34a;
            color: white;
            border: none;
            padding: 7px 12px;
            border-radius: 6px;
            cursor: pointer;
        }

        .reject {
            background: #dc2626;
            color: white;
            border: none;
            padding: 7px 12px;
            border-radius: 6px;
            cursor: pointer;
        }

        button {
            transition: 0.25s;
        }

        button:hover {
            transform: translateY(-2px);
        }

        /* ================= ANIMATIONS ================= */

        @keyframes slideIn {
            from {
                transform: translateX(-100%);
            }
            to {
                transform: translateX(0);
            }
        }

        @keyframes fadeDown {
            from {
                opacity: 0;
                transform: translateY(-20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(25px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @keyframes scaleIn {
            from {
                opacity: 0;
                transform: scale(0.9);
            }
            to {
                opacity: 1;
                transform: scale(1);
            }
        }

        /* ================= RESPONSIVE ================= */

        @media (max-width: 1000px) {
            .cards {
                grid-template-columns: repeat(2, 1fr);
            }

            .content {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 700px) {
            .sidebar {
                position: relative;
                width: 100%;
                height: auto;
            }

            .main {
                margin-left: 0;
            }

            .cards {
                grid-template-columns: 1fr;
            }

            .header {
                flex-direction: column;
                gap: 15px;
            }

            table {
                font-size: 12px;
            }
        }
    </style>
</head>

<body>

    <!-- ================= SIDEBAR ================= -->

    <aside class="sidebar">

        <div class="logo">
            <span>EMP</span> Portal
        </div>

        <div class="menu">
            <a href="#" class="active">🏠 Dashboard</a>
            <a href="#">👤 Profile</a>
            <a href="#">📅 Attendance</a>
            <a href="#">📝 Leave Requests</a>
            <a href="#">🔔 Notifications</a>
            <a href="#">⚙️ Settings</a>
